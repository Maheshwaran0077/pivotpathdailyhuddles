PORT=5000
REACT_APP_API_URL=http://localhost:5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dailyhuddles?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here

# Google Gemini Vision Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash
AI_ANALYSIS_TIMEOUT_MS=25000
AI_MAX_RETRIES=2
AI_BEFORE_AFTER_CACHE_ENABLED=true
AI_ANALYSIS_VERSION=1.0.0

# SMTP / Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
